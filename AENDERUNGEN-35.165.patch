+        const letzteMeldung = [...ntS].reverse().find((x) => x.ntNote);
+        const rollen = {}; ntS.forEach((x) => { if (x.ntRolle) rollen[x.ntRolle] = (rollen[x.ntRolle] || 0) + 1; });
