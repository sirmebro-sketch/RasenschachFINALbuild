+    const bar = document.querySelector(".tbar");
+    const hoch = (bar && bar.getBoundingClientRect ? bar.getBoundingClientRect().height : 0) + 10;
+    const y = el.getBoundingClientRect().top + (window.scrollY || 0) - hoch;
