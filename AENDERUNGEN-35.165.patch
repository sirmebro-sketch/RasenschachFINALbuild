+  if (dL) sofort.push({ w: Math.abs(dL), t: FX_NAMEN.legacy + " " + zeichen(dL) + dL });
+  Object.keys(AK_NAMEN).forEach((k) => {
+    const d = Math.round((p.attrs[k] || 0) - (vor.attrs[k] || 0));
