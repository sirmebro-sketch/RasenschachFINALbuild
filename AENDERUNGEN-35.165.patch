+  const R = 34, U = 2 * Math.PI * R;
+  return (
+    <div style={{ position: "relative", width: 84, height: 84, flexShrink: 0 }}>
+      <svg viewBox="0 0 84 84" style={{ width: 84, height: 84, transform: "rotate(-90deg)" }}>
