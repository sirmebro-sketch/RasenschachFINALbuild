+/* Fängt Fehler einzelner Ansichten ab, damit nie die ganze App weiß wird */
+class Guard extends React.Component {
+  constructor(pr) { super(pr); this.state = { err: null }; }
+  static getDerivedStateFromError(err) { return { err }; }
