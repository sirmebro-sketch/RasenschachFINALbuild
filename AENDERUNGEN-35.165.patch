+  const dS = (p.suspended || 0) - vor.sperre;
+  if (dS > 0) spaeter.push(dS + (dS === 1 ? " Spiel Sperre" : " Spiele Sperre"));
+  if (spaeter.length) log.push("Vorgemerkt: " + spaeter.join(" · "));
