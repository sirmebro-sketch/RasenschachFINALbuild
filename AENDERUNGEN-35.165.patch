+        <circle cx="42" cy="42" r={R} fill="none" stroke={farbe} strokeWidth="7" strokeLinecap="round"
+          strokeDasharray={U} strokeDashoffset={U * (1 - anteil)}
+          style={{ transition: RUHE ? "none" : "stroke-dashoffset 1.1s cubic-bezier(.2,.8,.3,1)" }} />
+      </svg>
