+                    style={{ fontSize: 9.5, width: 22, height: 20, display: "inline-flex", alignItems: "center", justifyContent: "center",
+                      borderRadius: 0, background: m.r === "S" ? "rgba(76,143,110,.25)" : m.r === "U" ? "var(--up)" : "rgba(150,71,63,.25)",
