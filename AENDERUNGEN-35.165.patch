+  money: "Geld", rep: "Bekanntheit", form: "Form", morale: "Moral",
+  trust: "Vertrauen des Trainers", fitness: "Fitness", legacy: "Vermächtnis",
+  injuryProne: "Verletzungsanfälligkeit", potential: "Potenzial",
