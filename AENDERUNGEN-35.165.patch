+      })()}
+      <div className="pan pad">
+        <div className="eb" style={{ marginBottom: 8 }}>Defensivarbeit</div>
+        <div className="g3">
+          <Stat k="Zweikämpfe" v={D.duelle} sub={D.sp ? (D.duelle / D.sp).toFixed(1) + " je Spiel" : ""} />
