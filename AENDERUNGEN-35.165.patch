+        style={{ opacity: stufe === "legende" ? .26 : .18 }}><i /></span>}
+      <span style={{ position: "relative", display: "block", padding: "5px 4px 14px" }}>
+        <span style={{ display: "flex", justifyContent: "space-between",
+          alignItems: "center", marginBottom: 2 }}>
