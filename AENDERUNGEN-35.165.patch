+  return { p, club: p.club, mate: pick(o), rival, star: o[0] || FBACK,
+    vet: byAge[byAge.length - 1] || FBACK, young: byAge[0] || FBACK,
+    rivalOrMate: (rival || o[0] || FBACK).name,
+    /* DER VEREIN, DEN MAN AUSGESCHLAGEN HAT (35.161, V06). `p.abgelehnt`
