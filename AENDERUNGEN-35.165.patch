+      }
+    }
+  }
+
+  if (p.flags.dreamOffer) {
+    const big = CLUBS.filter((x) => x.g === p.g && x.s >= (p.g === "w" ? 82 : 86) && x.n !== p.club.n && (free || feeAsk <= clubBudget(x)));
+    if (big.length) {
+      const c = pick(big), r = roleFor(p.ovr, c.s, 55);
