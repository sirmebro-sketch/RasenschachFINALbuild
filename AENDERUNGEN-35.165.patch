+  if (n <= 1) return seed;
+  const h = Math.abs(seed | 0);
+  const alt = (h >> bit) % n;
+  const neu = ((alt + richtung) % n + n) % n;
+  return h + (neu - alt) * Math.pow(2, bit);
+}
