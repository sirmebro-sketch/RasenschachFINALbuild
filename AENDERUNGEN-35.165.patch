+          <Stat k={isTW ? "Paraden über Erwartung" : "Klärungen und Blocks"} v={D.verh}
+            sub={D.sp ? (D.verh / D.sp).toFixed(2) + " je Spiel" : ""} />
+          <Stat k="Spiele ohne Gegentor" v={csGesamt}
