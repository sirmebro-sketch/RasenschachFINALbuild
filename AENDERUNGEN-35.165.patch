+    const near = { IV:["ZDM","AV"], AV:["AF","IV"], ZDM:["ZM","IV"], ZM:["ZOM","ZDM"], ZOM:["ZM","AF"], AF:["ZOM","ST"], ST:["AF","ZOM"] };
